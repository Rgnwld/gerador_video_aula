DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-em-producao"

# "acp" (usa o Claude local via Agent Client Protocol — sem precisar de API key,
# reaproveita o login do `claude` já feito na máquina), "anthropic" (API da
# Claude) ou "ollama" (modelo local via Ollama)
AI_PROVIDER="acp"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Usado apenas quando AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
