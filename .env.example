DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="troque-por-um-segredo-aleatorio-em-producao"

# Valores padrão/fallback do provedor de IA — o admin pode sobrescrever tudo
# isso em /admin/configuracoes sem precisar mexer no .env ou reiniciar o
# servidor. "acp" (Claude local via Agent Client Protocol — sem precisar de
# API key), "anthropic" (API da Claude) ou "ollama" (modelo local via Ollama).
AI_PROVIDER="acp"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Usado apenas quando AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"
